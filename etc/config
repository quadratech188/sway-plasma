exec /home/quadratech/Projects/sway-plasma/etc/continue-kde-startup

# Input

input "type:keyboard" {
	repeat_delay 200
	repeat_rate 25
}

input "type:pointer" {
	accel_profile flat
	pointer_accel 0.8
}

input "type:touchpad" {
	natural_scroll enabled
	tap enabled
	drag_lock disabled
}

# Style

gaps inner 10

font 'Noto Sans' 9
titlebar_border_thickness 0

client.focused          #000000   #c2e4fe    #1f1f1f
client.focused_inactive #000000   #e5f2fd    #4f4f4f
client.unfocused        #000000   #dbdbdb    #7f7f7f

# Gestures

bindgesture swipe:3:left workspace next
bindgesture swipe:3:right workspace prev
bindgesture swipe:3:up exec $menu
bindgesture swipe:3:down exec wtype -k 'Escape'

bindgesture swipe:4:up move up
bindgesture swipe:4:left move left
bindgesture swipe:4:right move right
bindgesture swipe:4:down move down

bindsym BTN_MIDDLE kill
bindsym --whole-window Super+BTN_MIDDLE kill

floating_modifier Super normal

# Keys

set $menu vicinae toggle
set $term kitty
set $zoom woomer
set $notifs dunstctl context
set $exit swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
set $step 80px

bindsym Super+Return exec $term
bindsym Alt+Hangul exec $menu
bindsym Super+N exec $notifs
bindsym Super+Z exec $zoom
bindsym Super+Alt+Control+R reload
bindsym Super+Alt+Control+E exec $exit

bindsym Super+Backspace kill

bindsym Super+H focus left
bindsym Super+J focus down
bindsym Super+K focus up
bindsym Super+L focus right

bindsym Super+Y move left $step
bindsym Super+U move down $step
bindsym Super+I move up $step
bindsym Super+O move right $step

bindsym Super+B split horizontal
bindsym Super+V split vertical
bindsym Super+Slash split none

bindsym Super+T layout tabbed
bindsym Super+S layout stacking
bindsym Super+Semicolon layout toggle split

bindsym Super+Period fullscreen
bindsym Super+BracketRight floating toggle
bindsym Super+BracketLeft focus mode_toggle

bindsym Super+Comma move scratchpad
bindsym Super+Apostrophe scratchpad show

bindsym Super+Equal focus parent
bindsym Super+Minus focus child

workspace_auto_back_and_forth yes

bindsym Super+1 workspace number 1
bindsym Super+2 workspace number 2
bindsym Super+3 workspace number 3
bindsym Super+4 workspace number 4
bindsym Super+5 workspace number 5
bindsym Super+6 workspace number 6
bindsym Super+7 workspace number 7
bindsym Super+8 workspace number 8
bindsym Super+9 workspace number 9
bindsym Super+0 workspace number 10

bindsym Super+Alt+1 move container to workspace number 1; workspace number 1
bindsym Super+Alt+2 move container to workspace number 2; workspace number 2
bindsym Super+Alt+3 move container to workspace number 3; workspace number 3
bindsym Super+Alt+4 move container to workspace number 4; workspace number 4
bindsym Super+Alt+5 move container to workspace number 5; workspace number 5
bindsym Super+Alt+6 move container to workspace number 6; workspace number 6
bindsym Super+Alt+7 move container to workspace number 7; workspace number 7
bindsym Super+Alt+8 move container to workspace number 8; workspace number 8
bindsym Super+Alt+9 move container to workspace number 9; workspace number 9
bindsym Super+Alt+0 move container to workspace number 10; workspace number 10

bindsym Super+Alt+Control+1 move workspace to output 1
bindsym Super+Alt+Control+2 move workspace to output 2

mode "resize" {
    bindsym H resize shrink width $step
    bindsym J resize grow height $step
    bindsym K resize shrink height $step
    bindsym L resize grow width $step
    bindsym Escape mode "default"
}
bindsym Super+R mode "resize"
