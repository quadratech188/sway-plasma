#!/usr/bin/env python3

"""
In Plasma, `kwin_wayland_wrapper` decides the values of

- WAYLAND_DISPLAY
- DISPLAY
-XAUTHORITY

, and gives it to kwin to use.

Sway doesn't accept these fields, so we can't do that.

Thankfully, all kwin_wayland_wrapper does afterwards is:

- Basically `dbus-update-activation-environment`
- Acquire `org.kde.KWinWrapper` (this is what allows the rest of KDE to begin booting)

So we can just do these things *after* Sway is launched, and everything should just work!
Hopefully...
"""

import os
import subprocess
import sys

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

environment = [
    "WAYLAND_DISPLAY",
    "DISPLAY",
    "I3SOCK",
    "SWAYSOCK",
    "XCURSOR_SIZE",
    "XCURSOR_THEME"
]

missing = [name for name in ['WAYLAND_DISPLAY', 'DISPLAY'] if not os.environ.get(name)]
if missing:
    sys.exit(f"plasma-sway-ready: missing environment: {', '.join(missing)}")

subprocess.run(
    ["dbus-update-activation-environment", "--systemd", *environment],
    check=True,
)

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

bus = dbus.SessionBus()

result = bus.request_name(
    "org.kde.KWinWrapper",
    dbus.bus.NAME_FLAG_DO_NOT_QUEUE,
)

if result not in (
    dbus.bus.REQUEST_NAME_REPLY_PRIMARY_OWNER,
    dbus.bus.REQUEST_NAME_REPLY_ALREADY_OWNER,
):
    sys.exit(
        f"plasma-sway-ready: failed to acquire org.kde.KWinWrapper: {result}"
    )

print(
    "plasma-sway-ready:"
    f" WAYLAND_DISPLAY={os.environ['WAYLAND_DISPLAY']}"
    f" DISPLAY={os.environ['DISPLAY']}",
    file=sys.stderr,
)

GLib.MainLoop().run()
