bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute        exec wpctl set-mute   @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute     exec wpctl set-mute   @DEFAULT_AUDIO_SOURCE@ toggle

bindsym XF86MonBrightnessDown exec qdbus-qt6 \
	org.kde.ScreenBrightness \
	/org/kde/ScreenBrightness \
	AdjustBrightnessRatio -0.05 0

bindsym XF86MonBrightnessUp exec qdbus-qt6 \
	org.kde.ScreenBrightness \
	/org/kde/ScreenBrightness \
	AdjustBrightnessRatio +0.05 0

# If you remove this KDE *WILL NOT BOOT PROPERLY*
exec /home/quadratech/Projects/sway-plasma/etc/continue-kde-startup

exec /home/quadratech/Projects/sway-plasma/etc/sway-extensions/build/sway-extensions
